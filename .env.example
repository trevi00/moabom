# compose 가 이 디렉터리의 `.env` 를 읽어 변수를 치환한다. 실제 `.env` 는 커밋 금지(.gitignore).
# 값을 바꾸려면 이 파일을 `.env` 로 복사한 뒤 수정한다.

# 미디어 루트 — 저장소 밖 (SC4). nginx 가 /srv/media 에 읽기 전용으로 마운트한다.
MEDIA_ROOT=D:/moabom-media

# 로컬 개발 전용 값입니다. 인터넷에 노출되지 않는 compose 네트워크 안에서만 씁니다 (ADR-0001 위협모델).
MYSQL_ROOT_PASSWORD=moabom-local
GRAFANA_PASSWORD=admin

# dev(`npm run dev`)에서 Next 가 프록시할 대상 — next.config.ts 의 기본값과 같습니다.
# ⚠️ Next 는 자신이 실행되는 디렉터리(frontend/)의 .env 를 읽는다 — 값을 바꾸려면 frontend/.env 에 둘 것.
#    full 프로필은 이 값을 쓰지 않는다: 목적지가 build 시점에 구워지므로 compose 의 build.args 가 정본이다
#    (01-03 실측 — 런타임 env 주입은 무효).
BACKEND_ORIGIN=http://localhost:8080
MEDIA_ORIGIN=http://localhost:8081
